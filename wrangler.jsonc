{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "torn-chain-manager-doobiie",
  "main": "src/index-targets.js",
  "compatibility_date": "2026-08-30",
  "vars": {
    "ALLOWED_FACTION_IDS": "53956"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_SESSIONS",
        "class_name": "AuthSession"
      },
      {
        "name": "FACTION_ROOMS",
        "class_name": "FactionRoom"
      },
      {
        "name": "TARGET_CALLS",
        "class_name": "TargetCalls"
      }
    ]
  },
  "exports": {
    "AuthSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FactionRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "TargetCalls": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
